# Copie para ".env" e preencha. NUNCA compartilhe o BOT_TOKEN.

# Token do bot, gerado pelo @BotFather no Telegram:
BOT_TOKEN=

# Seu ID do Telegram (e de outros admins), separados por vírgula.
# Para descobrir seu ID: fale com o bot e envie /id (depois que ele estiver no ar),
# ou use o bot @userinfobot no Telegram.
ADMIN_IDS=

# Área interna do site (/interno): login do primeiro administrador.
# Só é usado na primeira subida (quando ainda não existe nenhum usuário).
# Depois, troque a senha e crie os outros logins em Usuários.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Endereço público (vai no QR do cupom térmico)
SITE_URL=https://tirodeguerra.com.br

# Opcionais:
CLUB_NAME=GUERRA Clube de Tiro
TZ=America/Sao_Paulo
PORT=8000
DB_PATH=/app/data/tiro_guerra.db
