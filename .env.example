# Copie para ".env" e preencha. NUNCA compartilhe a senha.

# Área interna: login do primeiro administrador.
# Só é usado na primeira subida (quando ainda não existe nenhum usuário).
# Depois, troque a senha e crie os outros logins em Usuários.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Domínio da área interna (precisa de registro DNS apontando para o servidor)
ADMIN_HOST=admin.tirodeguerra.com.br

# Endereço público (vai no QR do cupom térmico)
SITE_URL=https://tirodeguerra.com.br

# Opcionais:
CLUB_NAME=GUERRA Clube de Tiro
TZ=America/Sao_Paulo
PORT=8000
DB_PATH=/app/data/tiro_guerra.db
